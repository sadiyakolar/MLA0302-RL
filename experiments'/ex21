#Use the Upper Confidence Bound (UCB) algorithm to dynamically select content for users on
a streaming platform. Implement the UCB algorithm in Python and compare its effectiveness
against other strategies.

import math
import random

n = int(input("Enter Number of Content: "))
rounds = int(input("Enter Number of Rounds: "))

reward = [0] * n
count = [0] * n

for t in range(1, rounds + 1):

    if t <= n:
        choice = t - 1
    else:
        ucb = []

        for i in range(n):
            average = reward[i] / count[i]
            value = average + math.sqrt(2 * math.log(t) / count[i])
            ucb.append(value)

        choice = ucb.index(max(ucb))

    r = random.randint(0, 1)

    reward[choice] += r
    count[choice] += 1

print("\nResults:")

for i in range(n):
    print("Content", i + 1, "Reward =", reward[i])

print("Best Content:", reward.index(max(reward)) + 1)
