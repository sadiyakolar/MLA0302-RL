#28) Develop an AI agent to play a real-time strategy game (e.g., Age of Empires) using ActorCritic
methods. Implement the actor and critic networks in Python and train the agent to build
structures, gather resources, and engage in strategic combat.

import random

print("RTS GAME USING ACTOR-CRITIC")

episodes = int(input("Enter Number of Episodes: "))
alpha = float(input("Enter Learning Rate: "))

actions = ["Build", "Gather", "Attack"]

actor = [0.0, 0.0, 0.0]
critic = 0.0

for episode in range(episodes):

    action = random.randint(0, 2)

    if action == 0:
        reward = 5
    elif action == 1:
        reward = 3
    else:
        reward = 10

    advantage = reward - critic

    actor[action] += alpha * advantage

    critic += alpha * advantage

    if episode % 10 == 0:
        print("Episode:", episode + 1,
              "Action:", actions[action],
              "Reward:", reward)

print("\nActor Values:")

for i in range(3):
    print(actions[i], "=", round(actor[i], 2))

best = actor.index(max(actor))

print("\nBest Strategy:", actions[best])
print("Training Completed")
