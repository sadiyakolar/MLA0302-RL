#34) A dynamic pricing platform aims to optimize its pricing strategy using model-based RL.
Develop a predictive model that forecasts customer demand and price sensitivities based on
historical sales data. Use Python to train the predictive model and implement a modelbased
policy optimization algorithm to dynamically adjust prices in response to changing market
conditions.


import random

print("DYNAMIC PRICING USING MODEL-BASED RL")

prices = [50, 75, 100, 125]

episodes = int(input("Enter Number of Episodes: "))
alpha = float(input("Enter Learning Rate: "))
gamma = float(input("Enter Discount Factor: "))

q = [0.0, 0.0, 0.0, 0.0]

for episode in range(episodes):

    # Simulate market demand
    base_demand = random.randint(50, 100)

    # Choose price
    action = random.randint(0, 3)

    price = prices[action]

    # Higher price reduces demand
    demand = base_demand - (action * 15)

    if demand < 0:
        demand = 0

    sales = demand

    revenue = price * sales

    # Reward = revenue
    reward = revenue

    # Model-based Q update
    next_value = max(q)

    q[action] = q[action] + alpha * (
        reward
        + gamma * next_value
        - q[action]
    )

    if episode % 10 == 0:

        print(
            "Episode:", episode + 1,
            "Price:", price,
            "Demand:", demand,
            "Revenue:", revenue
        )

print("\nFinal Pricing Policy")

for i in range(4):

    print(
        "Price:",
        prices[i],
        "Q Value:",
        round(q[i], 2)
    )

best = q.index(max(q))

print("\nOptimal Price:", prices[best])

print(
    "Expected Best Value:",
    round(q[best], 2)
)

print("Training Completed")
